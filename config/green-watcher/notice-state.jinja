{%- set status = states('sensor.letterboxd_green_watcher_status') -%}
{%- set last = states('input_text.letterboxd_green_watcher_last_notice') -%}
{%- set issues = ['invalid_health', 'heartbeat_stale', 'local_silence', 'paused', 'failed', 'incident', 'inactive'] -%}
{%- set desired = namespace(key='quiet') -%}
{%- if status in issues or status == 'review_required' -%}
  {%- set desired.key = status -%}
{%- elif status == 'success_seen' and states('input_boolean.letterboxd_green_first_success_notified') == 'off' -%}
  {%- set desired.key = 'first_success' -%}
{%- elif status in ['baseline', 'idle', 'syncing', 'success_seen'] and last in issues -%}
  {%- set desired.key = 'recovery' -%}
{%- endif -%}
{{- desired.key if desired.key != last else 'quiet' -}}
